DATABASE_URL=postgresql://peraplano:peraplano@localhost:5432/peraplano
JWT_SECRET=change_me_generate_a_long_random_string
PORT=3000
TELEMETRY_RATE_LIMIT_MAX=60
AUTH_RATE_LIMIT_MAX=10

# Google sign-in and Play Integrity. All five are required; the API refuses to boot without them.
# GOOGLE_OAUTH_CLIENT_ID is the Web client id the Android app requests its ID token for.
GOOGLE_OAUTH_CLIENT_ID=change_me.apps.googleusercontent.com
PLAY_PACKAGE_NAME=com.filldev.peraplano
# One line of JSON for the service account allowed to call playintegrity.googleapis.com. This is
# a secret: keep the real value in an encrypted file, never here.
PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON={"client_email":"change_me@example.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}
# The beta cohort window, epoch milliseconds. An install stamped inside it earns permanent Plus,
# so these two are a business decision, not a tuning knob.
BETA_WINDOW_START_AT=1750000000000
BETA_WINDOW_END_AT=1760000000000

# Optional, defaults shown.
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
INTEGRITY_MAX_SKEW_MS=300000
GOOGLE_AUTH_RATE_LIMIT_MAX=20
