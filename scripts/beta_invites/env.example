# Copy to .env (gitignored) and fill in. Nothing here is a real credential.
#
#   cp env.example .env
#
# SMTP_PASSWORD must be a Google App Password, not your account password:
#   myaccount.google.com  ->  Security  ->  2-Step Verification (must be ON)
#   ->  App passwords  ->  create one  ->  paste the 16 characters below.
# Spaces in it are fine, they get stripped.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=abcd efgh ijkl mnop

MAIL_FROM_NAME=PeraPlano
# Leave MAIL_FROM_EMAIL unset unless the address is a verified Gmail alias. Gmail rewrites
# any From header it does not recognise, and the rewritten one is what testers reply to.
# MAIL_FROM_EMAIL=you@gmail.com
# MAIL_REPLY_TO=you@gmail.com
# SUPPORT_EMAIL=you@gmail.com

PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.filldev.peraplano
# The closed-testing opt-in link from Play Console (Testing -> Closed testing -> your track
# -> Testers -> "Copy link"). Without it a tester who taps the store link sees "item not
# found", because Play hides the listing until they have opted in.
# PLAY_OPT_IN_URL=https://play.google.com/apps/testing/com.filldev.peraplano
BETA_PAGE_URL=https://peraplano.filhmar.online/en/beta

# Milliseconds between messages, and a self-imposed ceiling per run. Free Gmail cuts off
# around 500 recipients per rolling 24 hours; Workspace around 2000.
SEND_DELAY_MS=4000
DAILY_LIMIT=400
